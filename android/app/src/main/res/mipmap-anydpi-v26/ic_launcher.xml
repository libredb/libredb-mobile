<?xml version="1.0" encoding="utf-8"?>
<!--
  The adaptive icon, for every launcher that masks. Without it Android draws the legacy bitmap inside a white
  circle and the mark is letterboxed into it.

  The background is the design system's dark page and the foreground is the mark alone, drawn on the 108dp canvas
  Android composes these on — of which only the middle 72dp is guaranteed to survive the mask, which is why
  `tool/generate_app_icons.dart` draws the mark smaller here than in the legacy bitmap (#390).
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
