# Points a prod-target build at the local Studio, Keycloak and LibreDB Platform in tool/studio-dev/docker-compose.yml,
# so the login page also offers the Platform entry. Needs the platform profile (--profile platform).
# Use with: --target lib/main/main_prod.dart --dart-define-from-file=tool/studio-dev/studio-dev-platform.env
# A device needs `adb reverse` for ports 8443, 9443 and 9445 and the stack's CA certificate; see docs/studio.md.
OIDC_ISSUER=https://localhost:8443/realms/libredb
OIDC_CLIENT_ID=libredb-mobile
PROD_API_URL=https://localhost:9443/api
PLATFORM_API_URL=https://localhost:9445/api
