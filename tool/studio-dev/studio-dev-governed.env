# Points a prod-target build at the governed Studio of the governed profile in tool/studio-dev/docker-compose.yml.
# Use with: --target lib/main/main_prod.dart --dart-define-from-file=tool/studio-dev/studio-dev-governed.env
# A device needs `adb reverse` for ports 8443 and 9444 and the stack's CA certificate; see docs/studio.md.
OIDC_ISSUER=https://localhost:8443/realms/libredb
OIDC_CLIENT_ID=libredb-mobile
PROD_API_URL=https://localhost:9444/api
