# Points a prod-target build at the local Studio and Keycloak in tool/studio-dev/docker-compose.yml.
# Use with: --target lib/main/main_prod.dart --dart-define-from-file=tool/studio-dev/studio-dev.env
# A device needs `adb reverse` for ports 8443 and 9443 and the stack's CA certificate; see docs/studio.md.
OIDC_ISSUER=https://localhost:8443/realms/libredb
OIDC_CLIENT_ID=libredb-mobile
PROD_API_URL=https://localhost:9443/api
